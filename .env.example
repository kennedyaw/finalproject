# Copy this file to .env and fill in your values. Never commit .env.

# Free key from https://api.nasa.gov (DEMO_KEY works but allows only ~30 requests/hour)
NASA_API_KEY=DEMO_KEY

# Leave blank to use a local SQLite file (asteroids.db).
# In production, set to your Supabase Postgres connection string (Session pooler).
DATABASE_URL=

# How long cached NASA data counts as fresh before refetching.
CACHE_TTL_HOURS=6
